---
interface Props {
  title: string;
  subtitle: string;
  overview: string;
  features: string[];
  docLinks: { label: string; href: string }[];
}
const { title, subtitle, overview, features, docLinks } = Astro.props;
---
<header class="py-16 px-4 text-center bg-gradient-to-b from-surface to-background">
  <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">{title}</h1>
  <p class="mt-2 text-muted">{subtitle}</p>
  <a href="/" class="inline-block mt-4 text-sm text-primary hover:underline">&larr; Back to Home</a>
</header>
<div class="max-w-3xl mx-auto px-4 py-12 space-y-8">
  <section>
    <h2 class="text-xl font-semibold text-foreground mb-3">Overview</h2>
    <p class="text-foreground/90">{overview}</p>
  </section>
  <section>
    <h3 class="text-lg font-semibold text-foreground mb-2">Key Features</h3>
    <ul class="list-disc list-inside space-y-1 text-foreground/90">
      {features.map((f) => <li>{f}</li>)}
    </ul>
  </section>
  <section>
    <h3 class="text-lg font-semibold text-foreground mb-2">Documentation & Usage</h3>
    <ul class="space-y-2">
      {docLinks.map(({ label, href }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{label}</a>
        </li>
      ))}
    </ul>
  </section>
  <section>
    <h3 class="text-lg font-semibold text-foreground mb-2">Contact</h3>
    <p class="text-foreground/90">For questions or collaboration, contact Dilanjan DK at <a href="mailto:ddiyabal@uwo.ca" class="text-primary hover:underline">ddiyabal@uwo.ca</a>.</p>
  </section>
</div>
