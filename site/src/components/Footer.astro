---
const social = [
  { href: 'https://www.linkedin.com/in/dilanjandk', label: 'LinkedIn' },
  { href: 'https://orcid.org/0009-0004-6672-2636', label: 'ORCID' },
];
---
<footer class="relative z-10 bg-gradient-to-r from-primary/90 to-primary border-t border-border text-white text-center py-8 mt-16">
  <p class="text-sm">© 2026 Dilanjan DK. All rights reserved.</p>
  <div class="footer-social flex justify-center gap-6 mt-4" aria-label="Social and academic profiles">
    {social.map(({ href, label }) => (
      <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class="opacity-90 hover:opacity-100 transition-opacity">
        {label === 'LinkedIn' && (
          <svg class="inline w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        )}
        {label === 'ORCID' && (
          <svg class="inline w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm-2 16.326H7.044V7.674H10v8.652zm4 0h-2.956V7.674H14v8.652zm-2-9.674a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/></svg>
        )}
      </a>
    ))}
  </div>
</footer>
