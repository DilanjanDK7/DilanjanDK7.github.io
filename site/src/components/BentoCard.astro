---
import ProjectTags from './ProjectTags.astro';
interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  tags: string[];
}
const { title, description, image, link, tags } = Astro.props;
---
<a href={link} class="group block rounded-[1.25rem] overflow-hidden border border-border bg-card transition-all hover:-translate-y-1 hover:border-primary/60 hover:shadow-xl hover:shadow-black/10 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background">
  <div class="aspect-video relative bg-surface overflow-hidden" style={`background-image: url('${image}'); background-size: cover; background-position: center;`}>
    <div class="absolute inset-0 bg-gradient-to-t from-background/90 to-transparent opacity-60 group-hover:opacity-35 transition-opacity" />
  </div>
  <div class="p-4 md:p-5">
    <h3 class="text-lg font-semibold text-foreground">{title}</h3>
    <div class="mt-2">
      <ProjectTags tags={tags} />
    </div>
    <p class="mt-3 text-sm text-muted line-clamp-2">{description}</p>
    <span class="inline-flex items-center gap-2 mt-3 text-sm font-medium text-primary group-hover:underline">Learn more <span aria-hidden="true">↗</span></span>
  </div>
</a>
