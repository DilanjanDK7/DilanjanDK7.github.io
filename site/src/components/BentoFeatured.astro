---
interface Props {
  title: string;
  description: string;
  imageUrl: string;
  href: string;
  ctaLabel?: string;
}
const { title, description, imageUrl, href, ctaLabel = 'View on GitHub' } = Astro.props;
---
<a href={href} class="bento-featured block rounded-2xl overflow-hidden border border-border bg-card transition-transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background" style={`background-image: url('${imageUrl}'); background-size: cover; background-position: center;`}>
  <div class="relative min-h-[280px] md:min-h-[320px] flex flex-col justify-end p-6 md:p-8 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
    <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">{title}</h2>
    <p class="text-white/90 mt-1 text-sm md:text-base max-w-xl">{description}</p>
    <span class="inline-block mt-4 px-4 py-2 rounded-lg border border-white/50 text-white text-sm font-medium hover:bg-white/10 transition-colors w-fit">
      {ctaLabel}
    </span>
  </div>
</a>
