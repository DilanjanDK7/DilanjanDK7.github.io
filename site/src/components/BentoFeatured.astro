---
interface Props {
  title: string;
  description: string;
  imageUrl: string;
  href: string;
  ctaLabel?: string;
}
const { title, description, imageUrl, href, ctaLabel = 'View on GitHub' } = Astro.props;
---
<a href={href} class="bento-featured group block rounded-[1.25rem] overflow-hidden border border-border bg-card transition-transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background" style={`background-image: url('${imageUrl}'); background-size: cover; background-position: center;`}>
  <div class="relative min-h-[300px] md:min-h-[360px] flex flex-col justify-end p-6 md:p-8 bg-gradient-to-t from-black/85 via-black/45 to-transparent">
    <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">{title}</h2>
    <p class="text-white/90 mt-1 text-sm md:text-base max-w-xl">{description}</p>
    <span class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-full border border-white/50 text-white text-sm font-medium group-hover:bg-white/10 transition-colors w-fit">
      {ctaLabel}
      <span aria-hidden="true">↗</span>
    </span>
  </div>
</a>
