---
const quotes = [

  // ══════════════════════════════════════════════════════════
  // SCIENCE & RESEARCH  (~70 quotes)
  // ══════════════════════════════════════════════════════════
  { category: 'Science', text: 'Somewhere, something incredible is waiting to be known.', author: 'Carl Sagan' },
  { category: 'Science', text: 'The important thing is to never stop questioning.', author: 'Albert Einstein' },
  { category: 'Science', text: 'The good thing about science is that it\'s true whether or not you believe in it.', author: 'Neil deGrasse Tyson' },
