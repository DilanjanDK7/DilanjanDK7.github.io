  { category: 'Science', text: 'Science is a way of thinking much more than it is a body of knowledge.', author: 'Carl Sagan' },
  { category: 'Science', text: 'The first principle is that you must not fool yourself — and you are the easiest person to fool.', author: 'Richard Feynman' },
  { category: 'Science', text: 'If you thought that science was certain — well, that is just an error on your part.', author: 'Richard Feynman' },
