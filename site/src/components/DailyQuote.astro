  { category: 'Science', text: 'The art and science of asking questions is the source of all knowledge.', author: 'Thomas Berger' },
  { category: 'Science', text: 'Reproducibility is the cornerstone of science. A result that cannot be reproduced is not a result.', author: 'Anonymous' },
  { category: 'Science', text: 'Every great advance in science has issued from a new audacity of imagination.', author: 'John Dewey' },
  { category: 'Science', text: 'The most beautiful experience we can have is the mysterious.', author: 'Albert Einstein' },
  { category: 'Science', text: 'Science is organized knowledge. Wisdom is organized life.', author: 'Immanuel Kant' },
  { category: 'Science', text: 'Somewhere, something incredible is waiting to be known.', author: 'Sharon Begley' },
  { category: 'Science', text: 'What we observe is not nature itself, but nature exposed to our method of questioning.', author: 'Werner Heisenberg' },
  { category: 'Science', text: 'The test of all knowledge is experiment. Experiment is the sole judge of scientific truth.', author: 'Richard Feynman' },
  { category: 'Science', text: 'Science is the process of thinking God\'s thoughts after Him.', author: 'Johannes Kepler' },
  { category: 'Science', text: 'It is strange that only extraordinary men make the discoveries which later appear so easy and simple.', author: 'Georg C. Lichtenberg' },
  { category: 'Science', text: 'The more I learn, the more I realize how much I don\'t know.', author: 'Albert Einstein' },
  { category: 'Science', text: 'A theory that fits all the facts is wrong because some facts are wrong.', author: 'Francis Crick' },
