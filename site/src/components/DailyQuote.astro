---

<section class="daily-quote-section px-4 py-12" aria-labelledby="daily-quote-title">
  <div class="max-w-4xl mx-auto rounded-[1.5rem] border border-border bg-card/80 p-6 md:p-8 text-center shadow-lg shadow-black/5">
    <p class="section-kicker">A thought for today</p>
    <h2 id="daily-quote-title" class="mt-3 text-2xl md:text-3xl font-bold tracking-tight text-foreground">Daily quote</h2>
    <blockquote class="mt-5" id="quoteBlock" style="transition: opacity 0.4s ease;">
      <p id="dailyQuoteText" class="text-xl md:text-2xl leading-relaxed text-foreground/90">Loading today's thought…</p>
      <footer id="dailyQuoteAuthor" class="mt-4 text-sm text-muted"></footer>
    </blockquote>
    <div class="mt-5 flex items-center justify-center gap-3">
      <span id="dailyQuoteCategory" class="inline-flex rounded-full border border-primary/40 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-primary"></span>
      <button
        id="newQuoteBtn"
        type="button"
        aria-label="Show a different quote"
        title="New quote (press Q)"
        style="display:inline-flex; align-items:center; gap:0.35rem; padding:0.25rem 0.75rem; border-radius:9999px; border:1px solid var(--border,#cfd8ea); background:transparent; font-size:0.75rem; cursor:pointer; color:var(--muted,#666); transition:color 0.2s, border-color 0.2s;"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        New quote
      </button>
    </div>
  </div>
</section>

<script define:vars={{ quotesJson: JSON.stringify(quotes) }}>
  const quotes = JSON.parse(quotesJson);

  function pickRandom(exclude) {
    let idx;
    do { idx = Math.floor(Math.random() * quotes.length); } while (quotes.length > 1 && idx === exclude);
    return idx;
  }

  function showQuote(idx, animate) {
    const block = document.getElementById('quoteBlock');
    const textEl = document.getElementById('dailyQuoteText');
    const authorEl = document.getElementById('dailyQuoteAuthor');
    const catEl = document.getElementById('dailyQuoteCategory');
    const q = quotes[idx];

    if (animate) {
      block.style.opacity = '0';
      setTimeout(() => {
        textEl.textContent = `\u201c${q.text}\u201d`;
        authorEl.textContent = `\u2014 ${q.author}`;
        catEl.textContent = q.category;
        block.style.opacity = '1';
      }, 200);
    } else {
      textEl.textContent = `\u201c${q.text}\u201d`;
      authorEl.textContent = `\u2014 ${q.author}`;
      catEl.textContent = q.category;
    }
    return idx;
  }

  let currentIdx = pickRandom(-1);
  showQuote(currentIdx, false);

  const btn = document.getElementById('newQuoteBtn');
  btn.addEventListener('click', () => {
    currentIdx = pickRandom(currentIdx);
    showQuote(currentIdx, true);
  });

  // Press Q anywhere on the page for a new quote
  document.addEventListener('keydown', (e) => {
    if (e.key === 'q' || e.key === 'Q') {
      if (['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)) return;
      currentIdx = pickRandom(currentIdx);
      showQuote(currentIdx, true);
    }
  });
</script>
