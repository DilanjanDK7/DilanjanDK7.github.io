---
import Layout from '../layouts/Layout.astro';

const subjects = [
  {
    title: 'Neuroimaging standards',
    description: 'The conventions and tools that make brain-imaging research easier to share and reproduce.',
    resources: [
      { name: 'BIDS', type: 'Specification', description: 'A standard for organizing and describing neuroimaging datasets.', href: 'https://bids-specification.readthedocs.io/' },
      { name: 'fMRIPrep', type: 'Pipeline', description: 'A robust preprocessing workflow for functional MRI data.', href: 'https://fmriprep.org/' },
    ],
  },
  {
    title: 'Computational neuroscience',
    description: 'Practical resources for turning neuroimaging data into interpretable analyses.',
    resources: [
      { name: 'Nilearn', type: 'Python library', description: 'Machine learning and statistical tools for neuroimaging in Python.', href: 'https://nilearn.github.io/' },
    ],
  },
];
---
<Layout
  title="Reading List | Dilanjan DK"
  description="A growing collection of books, papers, standards, and software resources for neuroimaging, computational neuroscience, and reproducible research."
>
  <header class="hero-shell py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="eyebrow">Field notes / resources</p>
      <h1 class="mt-5 max-w-3xl text-5xl md:text-7xl font-bold leading-[0.95] tracking-[-0.03em] text-foreground">Things worth reading, using, and returning to.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-foreground/75">A curated shelf of standards, tools, papers, and eventually novels that shape how I think about brains, data, and useful scientific software.</p>
    </div>
  </header>
  <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
    <div class="grid lg:grid-cols-[0.72fr_1.28fr] gap-12">
      <aside class="lg:sticky lg:top-24 self-start">
        <p class="section-kicker">Browse by subject</p>
        <nav class="mt-5 space-y-2" aria-label="Reading list subjects">
          {subjects.map((subject, index) => (
            <a href={`#subject-${index + 1}`} class="block border-l-2 border-border px-4 py-2 text-sm text-muted hover:border-primary hover:text-foreground transition-colors">{subject.title}</a>
          ))}
          <a href="#books" class="block border-l-2 border-border px-4 py-2 text-sm text-muted hover:border-primary hover:text-foreground transition-colors">Books & novels</a>
        </nav>
        <p class="mt-8 text-sm leading-relaxed text-muted">This list will grow as I add the resources I actually use, teach, and recommend.</p>
      </aside>

      <div class="space-y-14">
        {subjects.map((subject, index) => (
          <section id={`subject-${index + 1}`} aria-labelledby={`subject-title-${index + 1}`}>
            <p class="section-kicker">Subject {String(index + 1).padStart(2, '0')}</p>
            <h2 id={`subject-title-${index + 1}`} class="mt-3 text-3xl font-bold tracking-tight text-foreground">{subject.title}</h2>
            <p class="mt-3 max-w-2xl text-muted leading-relaxed">{subject.description}</p>
            <div class="mt-6 divide-y divide-border border-y border-border">
              {subject.resources.map((resource) => (
                <article class="py-5 grid sm:grid-cols-[1fr_auto] gap-4 items-start">
                  <div>
                    <span class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">{resource.type}</span>
                    <h3 class="mt-1 text-xl font-semibold text-foreground">{resource.name}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted">{resource.description}</p>
                  </div>
                  <a href={resource.href} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary hover:underline whitespace-nowrap">Open resource <span aria-hidden="true">↗</span></a>
                </article>
              ))}
            </div>
          </section>
        ))}

        <section id="books" aria-labelledby="books-title" class="surface-band p-6 md:p-8 rounded-[1.25rem]">
          <p class="section-kicker">Long-form reading</p>
          <h2 id="books-title" class="mt-3 text-3xl font-bold tracking-tight text-foreground">Books & novels</h2>
          <p class="mt-3 max-w-2xl text-muted leading-relaxed">A space for the books that sharpen intuition, widen perspective, or simply make a long train ride better. Recommendations will be added here.</p>
        </section>
      </div>
    </div>
  </div>
</Layout>
