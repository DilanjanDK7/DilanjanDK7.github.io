---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found | Dilanjan DK" description="The page you're looking for doesn't exist.">
  <header class="py-20 px-4 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-foreground">404 — Page Not Found</h1>
    <p class="mt-4 text-muted">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="inline-block mt-8 px-6 py-3 rounded-xl bg-primary text-white font-medium hover:opacity-90 transition-opacity">Return Home</a>
  </header>
</Layout>
