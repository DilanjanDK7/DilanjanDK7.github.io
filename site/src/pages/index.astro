---
import Layout from '../layouts/Layout.astro';
import BentoFeatured from '../components/BentoFeatured.astro';
import BentoCard from '../components/BentoCard.astro';
import projects from '../data/projects.json';

const epiflow = projects.find((p) => p.key === 'epiflow')!;
const secondary = projects.filter((p) => p.key !== 'epiflow');
---

<Layout
  title="Dilanjan DK | Computational Neuroscience Portfolio"
  description="Computational neuroscience portfolio focused on reproducible neuroimaging pipelines, scientific software, and EEG pain decoding research."
  ogImage="/assets/images/projects/epiflow-system.png"
>
  <section class="hero-shell px-4 py-16 md:py-24">
    <video class="hero-background" autoplay muted loop playsinline preload="metadata" poster="/assets/images/about-neuroimaging.jpg" aria-hidden="true">
      <source src="/assets/video/site-background.mp4" type="video/mp4" />
    </video>
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-20 items-center">
      <div class="hero-copy">
        <p class="eyebrow">Computational neuroscience / Western University</p>
        <h1 class="mt-5 text-5xl md:text-7xl font-bold leading-[0.95] tracking-[-0.03em] text-foreground">Tools for seeing how the brain works.</h1>
        <p class="mt-6 text-lg md:text-xl leading-relaxed text-foreground/80 max-w-xl">I build reproducible neuroimaging pipelines and scientific software that turn complex brain data into useful, inspectable evidence.</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#projects" class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-primary text-white font-semibold shadow-lg shadow-primary/20 hover:-translate-y-0.5 transition-transform">Explore the work <span aria-hidden="true">↘</span></a>
          <a href="/about" class="text-sm font-semibold text-foreground/75 hover:text-primary transition-colors">More about me <span aria-hidden="true">→</span></a>
        </div>
        <div class="mt-10 flex items-center gap-3 text-sm text-muted">
          <span class="inline-block w-2 h-2 rounded-full bg-accent" aria-hidden="true"></span>
          <span>Open-source research tools, built for real workflows.</span>
        </div>
      </div>
      <div class="hero-visual relative">
        <div class="absolute -inset-3 rounded-[2rem] border border-accent/20 rotate-2" aria-hidden="true"></div>
        <figure class="image-frame relative overflow-hidden rounded-[1.5rem] border border-border bg-card">
          <img src="/assets/images/Epiflow.png" alt="EpiFlow brain imaging pipeline visualisation" class="aspect-[16/10] w-full object-cover" width="1536" height="864" fetchpriority="high" />
          <figcaption class="absolute bottom-0 inset-x-0 px-5 py-4 bg-gradient-to-t from-black/80 to-transparent text-white">
            <span class="text-xs uppercase tracking-[0.16em] text-white/70">Featured system</span>
            <span class="block mt-1 text-lg font-semibold">EpiFlow / fMRI processing for epilepsy research</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="featured-research" class="surface-band py-12 px-4">
    <div class="max-w-6xl mx-auto grid md:grid-cols-[0.45fr_1fr] gap-8 items-start">
      <div>
        <p class="section-kicker">Where I focus</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground">Research with a practical edge.</h2>
      </div>
      <ul class="grid sm:grid-cols-2 gap-6">
      <li class="border-l-2 border-primary pl-5">
        <strong class="text-foreground">Clinical neuroimaging</strong>
        <span class="block mt-2 text-sm leading-relaxed text-muted">Reproducible fMRI workflows and analysis tools for neuroscience research.</span>
      </li>
      <li class="border-l-2 border-accent pl-5">
        <strong class="text-foreground">EEG pain decoding</strong>
        <span class="block mt-2 text-sm leading-relaxed text-muted">Multimodal computational methods for studying pain-related neural signals.</span>
      </li>
      </ul>
    </div>
  </section>

  <section id="about" class="py-20 px-4 max-w-6xl mx-auto">
    <div class="max-w-4xl grid md:grid-cols-[0.8fr_1.2fr] gap-10 items-center">
      <div>
        <p class="section-kicker">A little context</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight text-foreground">Curiosity, made reproducible.</h2>
        <div class="mt-8 w-40 h-40 md:w-48 md:h-48 rounded-[1.5rem] overflow-hidden border border-border bg-card image-frame rotate-[-3deg]">
          <img src="/assets/images/Dilanjan.png" alt="Portrait of Dilanjan Diyabalanage" class="w-full h-full object-cover" width="749" height="757" loading="lazy" />
        </div>
      </div>
      <div class="flex-1 prose prose-invert max-w-none">
        <p class="text-foreground/90">I'm Dilanjan Diyabalanage, a computational neuroscientist and researcher at Western University. My work focuses on clinical neuroimaging, EEG pain decoding, and open-source scientific software for fMRI and brain data. I build scalable, reproducible methods and translate complex techniques into practical tools for the community.</p>
        <p class="mt-4 text-foreground/80">Contact: <a href="mailto:ddiyabal@uwo.ca" class="text-primary hover:underline">ddiyabal@uwo.ca</a> | <a href="https://github.com/DilanjanDK7" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">GitHub</a> | <a href="https://www.linkedin.com/in/dilanjandk" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">LinkedIn</a> | <a href="https://orcid.org/0009-0004-6672-2636" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">ORCID</a></p>
      </div>
    </div>
  </section>

  <section id="projects" class="py-20 px-4 max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <p class="section-kicker">Selected work</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight text-foreground">Projects that do the heavy lifting.</h2>
      </div>
      <a href="/projects" class="text-sm font-semibold text-primary hover:underline">View all projects →</a>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 lg:row-span-1">
        <BentoFeatured
          title={epiflow.title}
          description="Advanced fMRI processing pipeline for epilepsy research."
          imageUrl={epiflow.image}
          href={epiflow.link}
          ctaLabel="View on GitHub"
        />
      </div>
      {secondary.map((p) => (
        <BentoCard title={p.title} description={p.description} image={p.image} link={p.link} tags={p.tags} />
      ))}
    </div>
  </section>

  <section id="contact" class="py-20 px-4 max-w-xl mx-auto">
    <p class="section-kicker">Start a conversation</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground mb-6">Have a difficult dataset?</h2>
    <form id="contactForm" action="https://formspree.io/f/mwkggdjb" method="POST" class="space-y-4">
      <input type="text" name="name" placeholder="Your name" required autocomplete="name" class="w-full px-4 py-3 rounded-lg bg-surface border border-border text-foreground placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary" />
      <input type="email" name="email" placeholder="Your email" required autocomplete="email" class="w-full px-4 py-3 rounded-lg bg-surface border border-border text-foreground placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary" />
      <textarea name="message" placeholder="Your message" required rows={4} class="w-full px-4 py-3 rounded-lg bg-surface border border-border text-foreground placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary resize-y" />
      <button type="submit" class="w-full py-3 rounded-lg bg-primary text-white font-medium hover:opacity-90 transition-opacity focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background">Send</button>
    </form>
    <div id="formMessage" role="status" aria-live="polite" class="mt-4 text-sm text-muted"></div>
  </section>
</Layout>
