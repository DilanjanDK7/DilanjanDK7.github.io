---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact | Dilanjan DK"
  description="Contact Dilanjan DK for research, collaboration, or questions."
>
  <header class="py-16 px-4 text-center bg-gradient-to-b from-surface to-background">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">Contact</h1>
    <p class="mt-2 text-muted">Say hello — I'd love to hear from you.</p>
  </header>
  <div class="max-w-xl mx-auto px-4 py-12">
    <h2 class="text-xl font-semibold text-foreground mb-4 text-center">Get in touch</h2>
    <form id="contactForm" action="https://formspree.io/f/xoevzgqd" method="POST" class="relative space-y-4" data-turnstile-form>
      <label class="block text-sm font-medium text-foreground">Name
        <input type="text" name="name" placeholder="Your name" required autocomplete="name" class="mt-1 w-full px-4 py-3 rounded-lg bg-surface border border-border text-foreground placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary" />
      </label>
      <label class="block text-sm font-medium text-foreground">Email
        <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="mt-1 w-full px-4 py-3 rounded-lg bg-surface border border-border text-foreground placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary" />
      </label>
      <label class="block text-sm font-medium text-foreground">Inquiry type
        <select name="inquiry_type" required class="mt-1 w-full px-4 py-3 rounded-lg bg-surface border border-border text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="" selected disabled>Select an option</option>
          <option value="research-collaboration">Research or collaboration</option>
          <option value="consultation">Consultation</option>
          <option value="full-cv-request">Request full CV</option>
          <option value="other">Other</option>
        </select>
      </label>
      <label class="block text-sm font-medium text-foreground">Message
        <textarea name="message" placeholder="Tell me a little about your project or question." required rows={4} class="mt-1 w-full px-4 py-3 rounded-lg bg-surface border border-border text-foreground placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary resize-y" />
      </label>
      <div hidden aria-hidden="true">
        <label for="contact-gotcha">Leave this field empty</label>
        <input id="contact-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>
      <div>
        <div data-turnstile-widget></div>
        <p data-turnstile-status role="status" aria-live="polite" class="mt-2 text-sm text-muted"></p>
      </div>
      <p class="text-sm leading-relaxed text-muted">Please do not include confidential, clinical, financial, or other sensitive personal information. Detailed CVs are shared after review.</p>
      <button type="submit" class="w-full py-3 rounded-lg bg-primary text-white font-medium hover:opacity-90 transition-opacity focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background">Send</button>
    </form>
    <div id="formMessage" role="status" aria-live="polite" class="mt-4 text-sm text-muted"></div>
  </div>
</Layout>
