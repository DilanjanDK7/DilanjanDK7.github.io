---
import Layout from '../layouts/Layout.astro';

const focusAreas = [
  'Clinical neuroimaging and fMRI analysis',
  'EEG analysis and machine learning',
  'Physics-informed computational modelling',
  'Reproducible scientific software',
];

const capabilities = [
  ['Scientific data systems', 'Designing practical workflows for fMRI, EEG, feature extraction, quality checks, and interpretable analysis.'],
  ['Machine learning', 'Applying classical and deep-learning methods to neural and health-data questions with rigorous evaluation.'],
  ['Research engineering', 'Building portable, documented tools with Python, Docker, Snakemake, version control, and clear handoffs.'],
  ['Technical planning', 'Turning an open research or product question into a scoped, testable implementation plan.'],
];

const selectedWork = [
  ['EpiFlow', 'A reproducible fMRI workflow for preprocessing and feature extraction in epilepsy research.'],
  ['Feature Extraction Container', 'A containerized and workflow-managed system for resting-state fMRI feature analysis.'],
  ['EEG machine learning', 'Deep-learning research for pain decoding, task-state recognition, and tinnitus classification.'],
  ['Physics-based brain modelling', 'Computational approaches connecting neural dynamics, structural connectivity, and functional organisation.'],
];

const toolkit = [
  ['Languages & development', 'Python, JavaScript, HTML, CSS, SQL, Bash, Git'],
  ['Scientific computing', 'NumPy, SciPy, pandas, scikit-learn, NiBabel, Nilearn, FINUFFT, h5py, Plotly'],
  ['Reproducible environments', 'Docker, Snakemake, BIDS, fMRIPrep, Linux, Python packaging'],
];
---

<Layout
  title="Professional Profile | Dilanjan DK"
  description="Professional profile of Dilanjan DK, a computational neuroscientist focused on neuroimaging, machine learning, and reproducible scientific software."
  ogImage="/assets/images/Epiflow.png"
>
  <header class="hero-shell px-4 py-16 md:py-24">
    <div class="max-w-6xl mx-auto">
      <p class="eyebrow">Professional profile</p>
      <h1 class="mt-5 max-w-4xl text-5xl md:text-7xl font-bold leading-[0.95] tracking-[-0.03em] text-foreground">Dilanjan DK</h1>
      <p class="mt-6 max-w-2xl text-lg md:text-xl leading-relaxed text-foreground/75">Computational neuroscientist working at the intersection of physics, machine learning, neuroimaging, and scientific software.</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm text-muted">
        <a href="https://www.linkedin.com/in/dilanjandk" target="_blank" rel="noopener noreferrer" class="rounded-full border border-border px-4 py-2 hover:border-primary hover:text-primary transition-colors">LinkedIn ↗</a>
        <a href="https://orcid.org/0009-0004-6672-2636" target="_blank" rel="noopener noreferrer" class="rounded-full border border-border px-4 py-2 hover:border-primary hover:text-primary transition-colors">ORCID ↗</a>
      </div>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
    <div class="grid lg:grid-cols-[0.65fr_1.35fr] gap-12">
      <aside class="lg:sticky lg:top-24 self-start">
        <p class="section-kicker">At a glance</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground">Research that connects models to meaning.</h2>
        <ul class="mt-6 space-y-3 text-sm leading-relaxed text-muted">
          {focusAreas.map((area) => <li class="flex gap-3"><span class="text-primary" aria-hidden="true">/</span><span>{area}</span></li>)}
        </ul>
      </aside>

      <div class="space-y-16">
        <section aria-labelledby="capabilities-title">
          <p class="section-kicker">01 / Capabilities</p>
          <h2 id="capabilities-title" class="mt-3 text-3xl font-bold tracking-tight text-foreground">Rigorous methods, useful delivery.</h2>
          <div class="mt-6 grid sm:grid-cols-2 gap-4">
            {capabilities.map(([title, detail]) => (
              <article class="rounded-[1.25rem] border border-border bg-card p-5">
                <h3 class="text-xl font-semibold text-foreground">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{detail}</p>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="selected-work-title">
          <p class="section-kicker">02 / Selected work</p>
          <h2 id="selected-work-title" class="mt-3 text-3xl font-bold tracking-tight text-foreground">Systems and research themes.</h2>
          <div class="mt-6 border-y border-border divide-y divide-border">
            {selectedWork.map(([title, detail]) => (
              <article class="py-6">
                <h3 class="text-xl font-semibold text-foreground">{title}</h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{detail}</p>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="toolkit-title">
          <p class="section-kicker">03 / Technical toolkit</p>
          <h2 id="toolkit-title" class="mt-3 text-3xl font-bold tracking-tight text-foreground">Packages and environments I use.</h2>
          <div class="mt-6 grid sm:grid-cols-2 gap-4">
            {toolkit.map(([title, tools]) => (
              <article class="rounded-[1.25rem] border border-border bg-card p-5">
                <h3 class="text-lg font-semibold text-foreground">{title}</h3>
                <p class="mt-2 text-sm font-semibold leading-relaxed text-accent">{tools}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="surface-band rounded-[1.25rem] p-6 md:p-8" aria-label="Full CV request">
          <p class="section-kicker">04 / Full CV</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground">Need a detailed CV?</h2>
          <p class="mt-3 max-w-2xl text-muted leading-relaxed">A detailed CV, including full education, experience, and presentation history, is available upon request.</p>
          <a href="/contact" class="inline-flex mt-6 items-center gap-2 rounded-full bg-primary px-5 py-3 font-semibold text-white hover:-translate-y-0.5 transition-transform">Request full CV <span aria-hidden="true">↗</span></a>
        </section>
      </div>
    </div>
  </div>
</Layout>
