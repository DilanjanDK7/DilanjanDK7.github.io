---
import Layout from '../layouts/Layout.astro';

const education = [
  {
    period: '2022 - Present',
    degree: 'PhD Candidate in Physics',
    institution: 'University of Western Ontario',
    detail: 'Collaborative Specialization in Machine Learning in Health and Biomedical Sciences.',
  },
  {
    period: '2021 - 2022',
    degree: 'MSc in Physics',
    institution: 'University of Western Ontario',
    detail: 'Graduate research in computational physics and brain-data analysis.',
  },
  {
    period: '2016 - 2020',
    degree: 'BSc (Hons.) in Physics',
    institution: 'University of Colombo, Sri Lanka',
    detail: 'Special degree, Second Upper Division. GPA: 3.59.',
  },
];

const research = [
  {
    period: '2022 - Present',
    role: 'PhD Research Assistant',
    institution: 'University of Western Ontario',
    project: 'Enhancing Neuroimaging Analysis through Physics-based Models and Deep Learning',
    detail: 'Developing computational models and machine learning methods to interpret complex neuroimaging data.',
  },
  {
    period: '2021 - 2022',
    role: "Master's Research Assistant",
    institution: 'University of Western Ontario',
    project: 'Analysis of Source Reconstructed EEG Data by a Model Inspired by Quantum Mechanics',
    detail: 'Modeling and reconstructing EEG data to extract dynamical features and relate them to spatial information.',
  },
  {
    period: '2019 - 2022',
    role: 'Undergraduate Research Assistant',
    institution: 'Department of Physics, University of Colombo',
    project: 'Investigating Sonoluminescence Bubble Dynamics in Ionic Solutions',
    detail: 'Undergraduate research in experimental and computational physics.',
  },
];

const workExperience = [
  {
    period: '2021 - Present',
    role: 'Teaching Assistant',
    institution: 'Western University',
    detail: 'Supporting undergraduate teaching, tutorials, assessment, and student learning across physics and related quantitative coursework.',
  },
  {
    period: '2024 - 2026',
    role: 'AI Research Associate',
    institution: 'Brainet.ca',
    detail: 'Contributing to applied AI research and the development of practical research and technology initiatives.',
  },
  {
    period: 'September 2026 - Present',
    role: 'Chief Technology Officer',
    institution: 'Brainet.ca',
    detail: 'Leading technical direction, research engineering, and the development of AI-focused systems and products.',
  },
];

const focusAreas = [
  'Clinical neuroimaging and fMRI analysis',
  'Physics-informed neural networks',
  'Machine learning for health and biomedical sciences',
  'EEG source reconstruction and dynamical features',
  'Reproducible scientific software and open research tools',
];

const industryStrengths = [
  ['Scientific software', 'Python-based tools and packages for neuroimaging, signal analysis, visualization, and research automation.'],
  ['Production workflows', 'Containerized and workflow-managed systems using Docker and Snakemake for repeatable analysis.'],
  ['Data-intensive analysis', 'fMRI, EEG, HDF5, 3D data, feature extraction, and interpretable computational methods.'],
  ['Technical communication', 'Documentation, user guides, troubleshooting, and clear translation of complex research systems.'],
];

const industryProjects = [
  { name: 'EpiFlow', detail: 'An epilepsy fMRI pipeline spanning optional DICOM-to-BIDS conversion, fMRIPrep preprocessing, and advanced feature extraction.' },
  { name: 'Feature Extraction Container', detail: 'A Dockerized, Snakemake-managed workflow for ALFF/fALFF, ReHo, Hurst, fractal dimension, QM-FFT, and RSN analysis.' },
  { name: 'BrainViz DK', detail: 'A brain visualization toolkit for interactive 3D rendering and neuroimaging data exploration.' },
  { name: 'QM FFT Feature Package', detail: 'A high-performance Python package for NUFFT-based 3D analysis, spectral metrics, HDF5 I/O, and visualization.' },
];
---

<Layout
  title="Curriculum Vitae | Dilanjan Diyabalanage"
  description="Academic and research profile of Dilanjan Diyabalanage, a computational neuroscientist and PhD candidate in Physics at Western University."
  ogImage="/assets/images/Epiflow.png"
>
  <header class="hero-shell px-4 py-16 md:py-24">
    <div class="max-w-6xl mx-auto">
      <p class="eyebrow">Academic profile / research CV</p>
      <h1 class="mt-5 max-w-4xl text-5xl md:text-7xl font-bold leading-[0.95] tracking-[-0.03em] text-foreground">Dilanjan Diyabalanage</h1>
      <p class="mt-6 max-w-2xl text-lg md:text-xl leading-relaxed text-foreground/75">Computational neuroscientist and PhD candidate working at the intersection of physics, machine learning, and neuroimaging.</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm text-muted">
        <a href="mailto:ddiyabal@uwo.ca" class="rounded-full border border-border px-4 py-2 hover:border-primary hover:text-primary transition-colors">ddiyabal@uwo.ca</a>
        <a href="https://www.linkedin.com/in/dilanjandk" target="_blank" rel="noopener noreferrer" class="rounded-full border border-border px-4 py-2 hover:border-primary hover:text-primary transition-colors">LinkedIn ↗</a>
        <a href="https://orcid.org/0009-0004-6672-2636" target="_blank" rel="noopener noreferrer" class="rounded-full border border-border px-4 py-2 hover:border-primary hover:text-primary transition-colors">ORCID ↗</a>
      </div>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
    <div class="grid lg:grid-cols-[0.65fr_1.35fr] gap-12">
      <aside class="lg:sticky lg:top-24 self-start">
        <p class="section-kicker">At a glance</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground">Research that connects models to meaning.</h2>
        <ul class="mt-6 space-y-3 text-sm leading-relaxed text-muted">
          {focusAreas.map((area) => <li class="flex gap-3"><span class="text-primary" aria-hidden="true">/</span><span>{area}</span></li>)}
        </ul>
      </aside>

      <div class="space-y-16">
        <div class="rounded-[1.25rem] border border-border bg-card p-2 flex flex-wrap gap-2" role="tablist" aria-label="CV versions">
          <button id="academicTab" type="button" role="tab" aria-selected="true" aria-controls="academicPanel" class="cv-tab rounded-full px-4 py-2 text-sm font-semibold bg-primary text-white">Academic CV</button>
          <button id="industryTab" type="button" role="tab" aria-selected="false" aria-controls="industryPanel" class="cv-tab rounded-full px-4 py-2 text-sm font-semibold text-muted hover:text-foreground">Industry CV</button>
        </div>

        <div id="academicPanel" role="tabpanel" aria-labelledby="academicTab" class="cv-panel space-y-16">
        <section aria-labelledby="education-title">
          <p class="section-kicker">01 / Education</p>
          <h2 id="education-title" class="mt-3 text-3xl font-bold tracking-tight text-foreground">Education</h2>
          <div class="mt-6 border-y border-border divide-y divide-border">
            {education.map((item) => (
              <article class="py-6 grid md:grid-cols-[9rem_1fr] gap-4">
                <p class="text-sm font-semibold text-primary">{item.period}</p>
                <div>
                  <h3 class="text-xl font-semibold text-foreground">{item.degree}</h3>
                  <p class="mt-1 text-foreground/80">{item.institution}</p>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{item.detail}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="research-title">
          <p class="section-kicker">02 / Experience</p>
          <h2 id="research-title" class="mt-3 text-3xl font-bold tracking-tight text-foreground">Research experience</h2>
          <div class="mt-6 border-y border-border divide-y divide-border">
            {research.map((item) => (
              <article class="py-6 grid md:grid-cols-[9rem_1fr] gap-4">
                <p class="text-sm font-semibold text-primary">{item.period}</p>
                <div>
                  <h3 class="text-xl font-semibold text-foreground">{item.role}</h3>
                  <p class="mt-1 text-foreground/80">{item.institution}</p>
                  <p class="mt-3 text-sm font-semibold text-accent">{item.project}</p>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{item.detail}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="work-title">
          <p class="section-kicker">03 / Professional work</p>
          <h2 id="work-title" class="mt-3 text-3xl font-bold tracking-tight text-foreground">Professional experience</h2>
          <div class="mt-6 border-y border-border divide-y divide-border">
            {workExperience.map((item) => (
              <article class="py-6 grid md:grid-cols-[9rem_1fr] gap-4">
                <p class="text-sm font-semibold text-primary">{item.period}</p>
                <div>
                  <h3 class="text-xl font-semibold text-foreground">{item.role}</h3>
                  <p class="mt-1 text-foreground/80">{item.institution}</p>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{item.detail}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="surface-band rounded-[1.25rem] p-6 md:p-8" aria-label="Contact invitation">
          <p class="section-kicker">04 / Connect</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground">Interested in the work?</h2>
          <p class="mt-3 max-w-2xl text-muted leading-relaxed">For research, collaboration, or scientific software conversations, email me or connect through LinkedIn.</p>
          <a href="mailto:ddiyabal@uwo.ca" class="inline-flex mt-6 items-center gap-2 rounded-full bg-primary px-5 py-3 font-semibold text-white hover:-translate-y-0.5 transition-transform">Get in touch <span aria-hidden="true">↗</span></a>
        </section>
        </div>

        <div id="industryPanel" role="tabpanel" aria-labelledby="industryTab" class="cv-panel hidden space-y-16">
          <section aria-labelledby="industry-strengths-title">
            <p class="section-kicker">01 / Capabilities</p>
            <h2 id="industry-strengths-title" class="mt-3 text-3xl font-bold tracking-tight text-foreground">Research engineering, made useful.</h2>
            <div class="mt-6 grid sm:grid-cols-2 gap-4">
              {industryStrengths.map(([title, detail]) => (
                <article class="rounded-[1.25rem] border border-border bg-card p-5">
                  <h3 class="text-xl font-semibold text-foreground">{title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section aria-labelledby="industry-projects-title">
            <p class="section-kicker">02 / Selected systems</p>
            <h2 id="industry-projects-title" class="mt-3 text-3xl font-bold tracking-tight text-foreground">Tools built for real workflows.</h2>
            <div class="mt-6 border-y border-border divide-y divide-border">
              {industryProjects.map((project) => (
                <article class="py-6">
                  <h3 class="text-xl font-semibold text-foreground">{project.name}</h3>
                  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{project.detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="surface-band rounded-[1.25rem] p-6 md:p-8" aria-label="Industry contact invitation">
            <p class="section-kicker">03 / Connect</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground">Building a research product or pipeline?</h2>
            <p class="mt-3 max-w-2xl text-muted leading-relaxed">I am interested in collaborations where rigorous scientific thinking meets reliable implementation.</p>
            <a href="mailto:ddiyabal@uwo.ca" class="inline-flex mt-6 items-center gap-2 rounded-full bg-primary px-5 py-3 font-semibold text-white hover:-translate-y-0.5 transition-transform">Start a conversation <span aria-hidden="true">↗</span></a>
          </section>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const academicTab = document.getElementById('academicTab');
  const industryTab = document.getElementById('industryTab');
  const academicPanel = document.getElementById('academicPanel');
  const industryPanel = document.getElementById('industryPanel');

  function setCvMode(mode: 'academic' | 'industry') {
    const academic = mode === 'academic';
    academicPanel?.classList.toggle('hidden', !academic);
    industryPanel?.classList.toggle('hidden', academic);
    academicTab?.setAttribute('aria-selected', String(academic));
    industryTab?.setAttribute('aria-selected', String(!academic));
    academicTab?.classList.toggle('bg-primary', academic);
    academicTab?.classList.toggle('text-white', academic);
    academicTab?.classList.toggle('text-muted', !academic);
    industryTab?.classList.toggle('bg-primary', !academic);
    industryTab?.classList.toggle('text-white', !academic);
    industryTab?.classList.toggle('text-muted', academic);
  }

  academicTab?.addEventListener('click', () => setCvMode('academic'));
  industryTab?.addEventListener('click', () => setCvMode('industry'));
</script>
